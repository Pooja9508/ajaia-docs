# ── Ajaia Docs — environment variables ────────────────────────────────────────
# Copy this file to .env and fill in the values.
# .env is git-ignored and must NEVER be committed to source control.

# JWT signing secret — generate a strong random value for production:
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
# Leave unset in development; a random key will be generated on each restart
# (tokens won't survive restarts — set this for a stable dev environment).
SECRET_KEY=

# Token expiry in minutes (default: 480 = 8 hours)
ACCESS_TOKEN_EXPIRE_MINUTES=480

# Database URL
# SQLite (default, zero-setup):
DATABASE_URL=sqlite:///./ajaia_docs.db
# PostgreSQL (production, e.g. Render free tier):
# DATABASE_URL=postgresql://user:password@host:5432/dbname

# Directory for uploaded files (created automatically if missing)
UPLOADS_DIR=uploads

# ── Email (optional) ──────────────────────────────────────────────────────────
# Used for: share notifications, email invitations, access request alerts.
# If not set, email sending is silently skipped and invite links are shown
# directly in the UI — sharing still works without SMTP configured.
#
# Gmail example:
#   SMTP_HOST=smtp.gmail.com
#   SMTP_PORT=587
#   SMTP_USER=you@gmail.com
#   SMTP_PASS=your-app-password   (Google App Password, not your account password)
#   SMTP_FROM=you@gmail.com
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM=noreply@ajaia-docs.com

# ── App URL ────────────────────────────────────────────────────────────────────
# Base URL used for building invitation links in emails.
# Change to your Render URL after deployment:
#   APP_URL=https://ajaia-docs.onrender.com/
APP_URL=http://localhost:8000/
